    "# 🔬 Model Deployment Diagnosis\n",
    "### by ThinkAutonomous.ai\n",
    "\n",
    "Upload your `.pth` file and find out **exactly why your model won't survive deployment.**\n",
    "\n",
    "This tool analyzes your model's weight file, estimates real-world inference performance on common AV hardware, and flags the bottlenecks standing between you and a production-ready system.\n",
    "\n",
    "---\n",
    "**How to use:**\n",
    "1. Run all cells top to bottom (Runtime → Run all)\n",
    "2. When prompted, upload your `.pth` or `.pt` file\n",
    "3. Read your diagnosis\n",
    "\n",
    "> ⚠️ This tool uses your model's **state dict** (weights only). No model code is required and nothing is sent to any server.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 1: Install dependencies ──────────────────────────────────────────────\n",
    "import subprocess, sys\n",
    "subprocess.run([sys.executable, '-m', 'pip', 'install', 'torch', '--quiet'], check=True)\n",
    "print('✅ Ready.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 2: Upload your .pth file ─────────────────────────────────────────────\n",
    "from google.colab import files\n",
    "print('📂 Upload your .pth or .pt file below:')\n",
    "uploaded = files.upload()\n",
    "MODEL_PATH = list(uploaded.keys())[0]\n",
    "print(f'\\n✅ File received: {MODEL_PATH}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 3: Parse the state dict ──────────────────────────────────────────────\n",
    "import torch\n",
    "import os\n",
    "from collections import defaultdict, Counter\n",
    "\n",
    "print('🔍 Analyzing your model...\\n')\n",
    "\n",
    "# Load state dict safely\n",
    "try:\n",
    "    state_dict = torch.load(MODEL_PATH, map_location='cpu', weights_only=True)\n",
    "except Exception:\n",
    "    # Fallback for older checkpoints\n",
    "    checkpoint = torch.load(MODEL_PATH, map_location='cpu')\n",
    "    if isinstance(checkpoint, dict):\n",
    "        # Try common checkpoint keys\n",
    "        for key in ['state_dict', 'model_state_dict', 'model', 'net']:\n",
    "            if key in checkpoint:\n",
    "                state_dict = checkpoint[key]\n",
    "                print(f'  → Found state dict under key: \"{key}\"')\n",
    "                break\n",
    "        else:\n",
    "            state_dict = checkpoint\n",
    "    else:\n",
    "        state_dict = checkpoint\n",
    "\n",
    "# ── Extract layer info ────────────────────────────────────────────────────────\n",
    "layer_stats = defaultdict(lambda: {'count': 0, 'params': 0})\n",
    "total_params = 0\n",
    "total_bytes = 0\n",
    "layer_names = []\n",
    "\n",
    "for name, tensor in state_dict.items():\n",
    "    if not isinstance(tensor, torch.Tensor):\n",
    "        continue\n",
    "\n",
    "    n_params = tensor.numel()\n",
    "    n_bytes = tensor.element_size() * n_params\n",
    "    total_params += n_params\n",
    "    total_bytes += n_bytes\n",
    "    layer_names.append(name)\n",
    "\n",
    "    # Infer layer type from weight name conventions\n",
    "    parts = name.split('.')\n",
    "    if 'weight' in name:\n",
    "        if tensor.dim() == 4:\n",
    "            layer_type = 'Conv2d'\n",
    "        elif tensor.dim() == 2:\n",
    "            layer_type = 'Linear'\n",
    "        elif tensor.dim() == 1:\n",
    "            layer_type = 'BatchNorm/LayerNorm'\n",
    "        else:\n",
    "            layer_type = f'Other ({tensor.dim()}D)'\n",
    "    elif 'bias' in name:\n",
    "        layer_type = 'Bias'\n",
    "    elif 'running_mean' in name or 'running_var' in name:\n",
    "        layer_type = 'BatchNorm (buffers)'\n",
    "    elif 'num_batches' in name:\n",
    "        layer_type = 'BatchNorm (buffers)'\n",
    "    else:\n",
    "        layer_type = 'Other'\n",
    "\n",
    "    layer_stats[layer_type]['count'] += 1\n",
    "    layer_stats[layer_type]['params'] += n_params\n",
    "\n",
    "# ── Compute derived metrics ───────────────────────────────────────────────────\n",
    "size_mb = total_bytes / (1024 ** 2)\n",
    "size_mb_fp16 = size_mb / 2\n",
    "size_mb_int8 = size_mb / 4\n",
    "\n",
    "conv_params = layer_stats['Conv2d']['params']\n",
    "linear_params = layer_stats['Linear']['params']\n",
    "conv_ratio = conv_params / total_params if total_params > 0 else 0\n",
    "linear_ratio = linear_params / total_params if total_params > 0 else 0\n",
    "\n",
    "n_unique_layers = len([k for k in layer_stats if 'buffer' not in k.lower()])\n",
    "depth_estimate = len([n for n in layer_names if 'weight' in n])\n",
    "\n",
    "print(f'  Parameters    : {total_params:,}')\n",
    "print(f'  Model size    : {size_mb:.1f} MB (FP32)')\n",
    "print(f'  Unique blocks : {n_unique_layers} types')\n",
    "print(f'  Weight layers : {depth_estimate}')\n",
    "print()\n",
    "print('  Layer breakdown:')\n",
    "for ltype, stats in sorted(layer_stats.items(), key=lambda x: -x[1]['params']):\n",
    "    if stats['params'] > 0:\n",
    "        pct = stats['params'] / total_params * 100\n",
    "        print(f'    {ltype:<28} {stats[\"count\"]:>4} layers   {stats[\"params\"]:>12,} params  ({pct:.1f}%)')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 4: Inference speed estimates ─────────────────────────────────────────\n",
    "# Based on published benchmarks for common AV edge hardware.\n",
    "# These are approximations for a single forward pass on a typical\n",
    "# perception model (input ~640x640 or ~224x224).\n",
    "\n",
    "# Throughput coefficients (params → ms), empirically calibrated\n",
    "# against published results on ResNet/EfficientDet/YOLO family.\n",
    "HARDWARE_PROFILES = {\n",
    "    'Jetson Orin NX (15W)' : {'coeff': 2.8e-8,  'trt_speedup': 3.2, 'fp16_speedup': 1.9},\n",
    "    'Jetson AGX Orin (60W)': {'coeff': 1.1e-8,  'trt_speedup': 3.5, 'fp16_speedup': 2.1},\n",
    "    'Jetson Xavier NX'     : {'coeff': 4.2e-8,  'trt_speedup': 2.8, 'fp16_speedup': 1.7},\n",
    "    'Raspberry Pi 5 (CPU)' : {'coeff': 4.5e-7,  'trt_speedup': 1.0, 'fp16_speedup': 1.0},\n",
    "    'Intel Core i7 (CPU)'  : {'coeff': 8.0e-8,  'trt_speedup': 1.0, 'fp16_speedup': 1.0},\n",
    "    'NVIDIA RTX 3080'      : {'coeff': 3.5e-9,  'trt_speedup': 2.5, 'fp16_speedup': 1.8},\n",
    "}\n",
    "\n",
    "REALTIME_THRESHOLD_MS = 33.3  # 30 FPS\n",
    "PRODUCTION_THRESHOLD_MS = 100  # 10 FPS — bare minimum for AV\n",
    "\n",
    "print('─' * 65)\n",
    "print(f'  INFERENCE SPEED ESTIMATES  ({total_params/1e6:.1f}M params, FP32)')\n",
    "print('─' * 65)\n",
    "print(f'  {\"Hardware\":<28} {\"FP32\":>8}  {\"FP16\":>8}  {\"TensorRT\":>10}')\n",
    "print('─' * 65)\n",
    "\n",
    "results = {}\n",
    "for hw, profile in HARDWARE_PROFILES.items():\n",
    "    ms_fp32 = total_params * profile['coeff'] * 1000\n",
    "    ms_fp16 = ms_fp32 / profile['fp16_speedup']\n",
    "    ms_trt  = ms_fp32 / profile['trt_speedup']\n",
    "    results[hw] = {'fp32': ms_fp32, 'fp16': ms_fp16, 'trt': ms_trt}\n",
    "\n",
    "    def fmt(ms):\n",
    "        if ms < REALTIME_THRESHOLD_MS:\n",
    "            return f'✅ {ms:.0f}ms'\n",
    "        elif ms < PRODUCTION_THRESHOLD_MS:\n",
    "            return f'⚠️  {ms:.0f}ms'\n",
    "        else:\n",
    "            return f'❌ {ms:.0f}ms'\n",
    "\n",
    "    print(f'  {hw:<28} {fmt(ms_fp32):>12}  {fmt(ms_fp16):>12}  {fmt(ms_trt):>12}')\n",
    "\n",
    "print('─' * 65)\n",
    "print(f'  ✅ Real-time (<{REALTIME_THRESHOLD_MS:.0f}ms / 30 FPS)   ⚠️  Functional (<{PRODUCTION_THRESHOLD_MS:.0f}ms)   ❌ Not viable')\n",
    "print()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 5: The Diagnosis ──────────────────────────────────────────────────────\n",
    "print()\n",
    "print('═' * 65)\n",
    "print('  YOUR DEPLOYMENT DIAGNOSIS')\n",
    "print('═' * 65)\n",
    "print()\n",
    "\n",
    "problems = []\n",
    "score = 100  # Start at 100, deduct for issues\n",
    "\n",
    "# ── Problem detection ─────────────────────────────────────────────────────────\n",
    "\n",
    "# Model size\n",
    "if total_params > 100e6:\n",
    "    problems.append(('CRITICAL', 'Model is too large for edge deployment',\n",
    "        f'{total_params/1e6:.0f}M parameters. Production AV perception models run 10-40M. '\n",
    "        f'You are {total_params/10e6:.1f}x over the typical limit.'))\n",
    "    score -= 35\n",
    "elif total_params > 40e6:\n",
    "    problems.append(('WARNING', 'Model is on the heavy side',\n",
    "        f'{total_params/1e6:.0f}M parameters. Deployable, but you will struggle on '\n",
    "        f'anything below an AGX Orin without significant optimization.'))\n",
    "    score -= 20\n",
    "elif total_params > 10e6:\n",
    "    problems.append(('INFO', 'Model size is acceptable',\n",
    "        f'{total_params/1e6:.0f}M parameters. Within range for edge deployment, '\n",
    "        f'but not yet optimized.'))\n",
    "    score -= 5\n",
    "else:\n",
    "    problems.append(('GOOD', 'Model is lightweight',\n",
    "        f'{total_params/1e6:.1f}M parameters. Good starting point for edge deployment.'))\n",
    "\n",
    "# Conv2d dominance\n",
    "if conv_ratio > 0.7:\n",
    "    problems.append(('WARNING', 'Heavy Conv2d architecture',\n",
    "        f'{conv_ratio*100:.0f}% of parameters are in Conv2d layers. '\n",
    "        f'Standard convolutions are slow on edge hardware. '\n",
    "        f'TensorRT can fuse some of these, but the architecture itself is a bottleneck.'))\n",
    "    score -= 15\n",
    "elif conv_ratio > 0.4:\n",
    "    problems.append(('INFO', 'Conv2d-heavy (typical for perception)',\n",
    "        f'{conv_ratio*100:.0f}% Conv2d. Normal for a perception model. '\n",
    "        f'TensorRT will give you significant gains here.'))\n",
    "\n",
    "# Linear layers (attention / transformers)\n",
    "if linear_ratio > 0.4:\n",
    "    problems.append(('WARNING', 'Large Linear/Attention blocks detected',\n",
    "        f'{linear_ratio*100:.0f}% of parameters are Linear layers. '\n",
    "        f'This often means Transformer blocks or large MLP heads. '\n",
    "        f'These are difficult to optimize for edge hardware and often require '\n",
    "        f'architectural changes, not just quantization.'))\n",
    "    score -= 15\n",
    "\n",
    "# Jetson Orin NX viability\n",
    "orin_nx_fp32 = results['Jetson Orin NX (15W)']['fp32']\n",
    "orin_nx_trt = results['Jetson Orin NX (15W)']['trt']\n",
    "if orin_nx_trt > REALTIME_THRESHOLD_MS:\n",
    "    problems.append(('CRITICAL', 'Not real-time even with TensorRT on Jetson Orin NX',\n",
    "        f'Estimated {orin_nx_trt:.0f}ms with TensorRT on Orin NX. '\n",
    "        f'You need under 33ms for 30 FPS. '\n",
    "        f'TensorRT alone will not fix this — the architecture needs to change.'))\n",
    "    score -= 25\n",
    "elif orin_nx_fp32 > REALTIME_THRESHOLD_MS and orin_nx_trt <= REALTIME_THRESHOLD_MS:\n",
    "    problems.append(('WARNING', 'Real-time only with TensorRT on Jetson Orin NX',\n",
    "        f'FP32: {orin_nx_fp32:.0f}ms (too slow). TensorRT: {orin_nx_trt:.0f}ms (viable). '\n",
    "        f'This means TensorRT is mandatory, not optional.'))\n",
    "    score -= 10\n",
    "\n",
    "# Model file size\n",
    "if size_mb > 500:\n",
    "    problems.append(('CRITICAL', 'Model file too large for OTA deployment',\n",
    "        f'{size_mb:.0f} MB on disk (FP32). Most AV systems have constraints on '\n",
    "        f'model file size for over-the-air updates. '\n",
    "        f'INT8 quantization would bring this to ~{size_mb_int8:.0f} MB.'))\n",
    "    score -= 10\n",
    "elif size_mb > 200:\n",
    "    problems.append(('WARNING', 'Large model file',\n",
    "        f'{size_mb:.0f} MB (FP32) → {size_mb_fp16:.0f} MB (FP16) → {size_mb_int8:.0f} MB (INT8). '\n",
    "        f'Quantization should be on your roadmap.'))\n",
    "    score -= 5\n",
    "\n",
    "# ── Print diagnosis ───────────────────────────────────────────────────────────\n",
    "ICONS = {'CRITICAL': '🔴', 'WARNING': '🟡', 'INFO': '🔵', 'GOOD': '🟢'}\n",
    "\n",
    "for severity, title, detail in problems:\n",
    "    icon = ICONS[severity]\n",
    "    print(f'{icon} [{severity}] {title}')\n",
    "    for line in [detail[i:i+72] for i in range(0, len(detail), 72)]:\n",
    "        print(f'   {line}')\n",
    "    print()\n",
    "\n",
    "# ── Score ─────────────────────────────────────────────────────────────────────\n",
    "score = max(0, score)\n",
    "print('─' * 65)\n",
    "if score >= 80:\n",
    "    grade = '✅  DEPLOYMENT READY — optimization will give you the edge'\n",
    "elif score >= 50:\n",
    "    grade = '⚠️   NEEDS WORK — deployable but not production-grade yet'\n",
    "elif score >= 25:\n",
    "    grade = '🟡  SIGNIFICANT ISSUES — optimization required before deployment'\n",
    "else:\n",
    "    grade = '🔴  NOT DEPLOYMENT READY — architectural changes needed'\n",
    "\n",
    "print(f'  Deployment Readiness Score: {score}/100')\n",
    "print(f'  {grade}')\n",
    "print('─' * 65)"
   ]
  },
